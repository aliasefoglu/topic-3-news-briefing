# Copy this to .env and fill in real values. DO NOT commit .env.

# --- LLM (for summary + labeling) ---
LLM_PROVIDER=anthropic        # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-6   # provider-specific model id
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Embeddings (semantic dedup, optional clustering) ---
EMBEDDING_PROVIDER=openai     # openai | gemini  (Anthropic has no embedding API)
EMBEDDING_MODEL=text-embedding-3-small
# (uses OPENAI_API_KEY or GOOGLE_API_KEY above)

# --- SE-layer settings (you will populate these) ---
LOG_LEVEL=INFO
# PostgreSQL connection string. For asyncpg, use the postgresql+asyncpg:// scheme.
# Spin up a local server with docker: `docker run -d --name pg -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16`
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/newsbrief
DIGESTS_DIR=./digests
DEDUP_NEAR_DUPLICATE_THRESHOLD=0.70
FETCH_TIMEOUT_SECONDS=15
MAX_PARALLEL_FETCHES=8
